APP_NAME=Go Template
APP_ENV=local
APP_URL=http://localhost:8080
SHUTDOWN_TIMEOUT=15s

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_BYTES=1048576
READINESS_CACHE_TTL=5s
CSRF_TRUSTED_ORIGINS=
TRUSTED_PROXIES=

LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_template_html
DB_SCHEMA=public
DB_IDLE_IN_TRANSACTION_TIMEOUT=60s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_LIFETIME_JITTER=5m
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s
WEB_DB_MAX_CONNS=10
WEB_DB_MIN_CONNS=0
WEB_DB_STATEMENT_TIMEOUT=10s

VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_KEY_PREFIX=go-template-html:

SESSION_IDLE_LIFETIME=2h
SESSION_ABSOLUTE_LIFETIME=24h

MAIL_PORT=1025
MAILPIT_UI_PORT=8025

PGWEB_PORT=8081
VALKEY_ADMIN_PORT=8082
