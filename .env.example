APP_NAME=Go Template
APP_ENV=local
APP_URL=http://localhost:8080
# Fill with the output of `openssl rand -base64 32`.
APP_KEY=
SHUTDOWN_TIMEOUT=15s

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_BYTES=1048576
READINESS_CACHE_TTL=5s
CSRF_TRUSTED_ORIGINS=
TRUSTED_PROXIES=

LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_template_html
DB_SCHEMA=public
DB_IDLE_IN_TRANSACTION_TIMEOUT=60s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_LIFETIME_JITTER=5m
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s
WEB_DB_MAX_CONNS=10
WEB_DB_MIN_CONNS=0
WEB_DB_STATEMENT_TIMEOUT=10s
WORKER_DB_MAX_CONNS=12

QUEUE_CONCURRENCY=10
QUEUE_POLL_INTERVAL=1s
QUEUE_FAILED_RETENTION=168h

VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_KEY_PREFIX=go-template-html:

SESSION_IDLE_LIFETIME=2h
SESSION_ABSOLUTE_LIFETIME=24h
REMEMBER_LIFETIME=720h
PASSWORD_CONFIRMATION_TIMEOUT=3h

PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1

SIGNED_URL_TTL=2h
EMAIL_VERIFICATION_TTL=60m
PASSWORD_RESET_TTL=60m

# Attempts per window.
RATE_LIMIT_REGISTRATION=5/1m
RATE_LIMIT_LOGIN=5/1m
RATE_LIMIT_PASSWORD_CONFIRMATION=5/1m
RATE_LIMIT_VERIFICATION_RESEND=6/1m
RATE_LIMIT_VERIFICATION_LINK=6/1m
RATE_LIMIT_FORGOT_PASSWORD=5/1m
RATE_LIMIT_FORGOT_PASSWORD_EMAIL=1/1m
RATE_LIMIT_RESET_PASSWORD=5/1m

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=hello@example.com
MAILPIT_UI_PORT=8025

PGWEB_PORT=8081
VALKEY_ADMIN_PORT=8082
