package component

templ SettingsPage(title, description string) {
	<div class="max-w-4xl">
		<div class="grid gap-8 md:grid-cols-3">
			<div>
				<h1 class="text-lg font-semibold">{ title }</h1>
				<p class="mt-1 text-sm text-zinc-500">{ description }</p>
			</div>
			<div class="md:col-span-2">
				{ children... }
			</div>
		</div>
	</div>
}
