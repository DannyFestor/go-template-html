package component

templ Icon(name IconName) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		class="size-5 shrink-0"
	>
		<path d={ heroiconOutlinePath(name) }></path>
	</svg>
}
