package component

import "github.com/DannyFestor/go-template-html/internal/route"

templ AppLogo(appName string) {
	<a href={ templ.SafeURL(route.Home) } class="flex items-center gap-2 font-semibold">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 32 32"
			aria-hidden="true"
			class="size-8 shrink-0 fill-zinc-900 dark:fill-white"
		>
			<rect width="32" height="32" rx="6"></rect>
			<path d="M10 11h12M10 16h12M10 21h7" class="stroke-white dark:stroke-zinc-900" stroke-width="2.5" stroke-linecap="round"></path>
		</svg>
		<span>{ appName }</span>
	</a>
}
