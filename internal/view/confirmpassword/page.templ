package confirmpassword

import (
	"github.com/DannyFestor/go-template-html/internal/route"
	"github.com/DannyFestor/go-template-html/internal/view/component"
)

type Form struct {
	Errors map[string]string
	Alert  string
}

templ Page(appName string, form Form) {
	@component.AuthSplit(appName, "Confirm your password", "This is a secure area of the application. Please confirm your password before continuing.") {
		<form
			method="post"
			action={ templ.SafeURL(route.ConfirmPassword) }
			hx-boost="false"
			novalidate
			class="flex flex-col gap-4"
		>
			@component.Alert(form.Alert)
			@component.Field(component.FieldProps{
				Label:        "Password",
				Name:         "password",
				Type:         "password",
				Value:        "",
				Placeholder:  "Password",
				Autocomplete: "current-password",
				Error:        form.Errors["password"],
			})
			@component.Button(component.ButtonProps{Label: "Confirm", Type: "submit", FullWidth: true})
		</form>
	}
}
