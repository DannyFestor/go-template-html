package register

import (
	"github.com/DannyFestor/go-template-html/internal/route"
	"github.com/DannyFestor/go-template-html/internal/view/component"
)

type Form struct {
	Name   string
	Email  string
	Errors map[string]string
	Alert  string
}

templ Page(appName string, form Form) {
	@component.AuthSplit(appName, "Create an account", "Enter your details below to create your account") {
		<form
			method="post"
			action={ templ.SafeURL(route.Register) }
			hx-boost="false"
			novalidate
			class="flex flex-col gap-4"
		>
			@component.Alert(form.Alert)
			@component.Field(component.FieldProps{
				Label:        "Name",
				Name:         "name",
				Type:         "text",
				Value:        form.Name,
				Placeholder:  "Full name",
				Autocomplete: "name",
				Error:        form.Errors["name"],
			})
			@component.Field(component.FieldProps{
				Label:        "Email address",
				Name:         "email",
				Type:         "email",
				Value:        form.Email,
				Placeholder:  "email@example.com",
				Autocomplete: "email",
				Error:        form.Errors["email"],
			})
			@component.Field(component.FieldProps{
				Label:        "Password",
				Name:         "password",
				Type:         "password",
				Value:        "",
				Placeholder:  "Password",
				Autocomplete: "new-password",
				Error:        form.Errors["password"],
			})
			@component.Field(component.FieldProps{
				Label:        "Confirm password",
				Name:         "password_confirmation",
				Type:         "password",
				Value:        "",
				Placeholder:  "Confirm password",
				Autocomplete: "new-password",
				Error:        form.Errors["password_confirmation"],
			})
			@component.Button(component.ButtonProps{Label: "Create account", Type: "submit", FullWidth: true})
		</form>
		<p class="text-center text-sm text-zinc-500">
			Already have an account?
			<a href={ templ.SafeURL(route.Login) } class="text-zinc-900 underline dark:text-white">Log in</a>
		</p>
	}
}
