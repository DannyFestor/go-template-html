package mail

import "strconv"

const ResetPasswordSubject = "Reset your password"

type ResetPassword struct {
	URL              string
	ExpiresInMinutes int
}

templ ResetPasswordBody(model ResetPassword) {
	<p>You are receiving this email because we received a password reset request for your account.</p>
	<p><a href={ templ.URL(model.URL) }>Reset password</a></p>
	<p>This password reset link will expire in { strconv.Itoa(model.ExpiresInMinutes) } minutes.</p>
	<p>If you did not request a password reset, no further action is required.</p>
}
